# 自分のサイトの設定。値は Vercel の Environment Variables に入れる（手元の確認では .env.local）。
# この一覧は src/lib/settings/environment.json から作っている。

# 保存先が専用の認証局を使う場合のルート証明書（PEM）。接続先の検証を省略せずに接続する（任意）
DATABASE_CA_CERT=
# 図（Mermaid）のページの図を、サーバーのブラウザで版ごとに 1 回描いて本文と一緒に配る（src/lib/first-paint/diagram-prerender.ts）。on のときだけ動く。描くたびに関数が 1 回ブラウザを起こすので、使う量を見てから入れる（任意）
PAGES_DIAGRAM_PRERENDER=
# 利用形態。配布物は deployment.json で配布版に固定されていて、ここで社内版へは戻せない（任意）
PAGES_EDITION=personal
# 設置した本人の Google アカウントのメールアドレス。保存先の初期化に使ったものと同じにする
PAGES_OWNER_EMAIL=
# 自分のサイトの URL（https://〜 のドメインまで）
PAGES_SITE_URL=
# ツールの名前。導入の最初に本人が決め、タブ・ログイン画面・サイドバー・共有カードに出る。未設定なら「Pages」（任意）
PAGES_SITE_NAME=My Pages
# 通常運転用の保存先の接続。初期化の脚本が .env.setup に追記したものを使う
DATABASE_URL=
# 保存先へ直接つなぐとき（DATABASE_URL）に同時に開く接続の上限（1〜20・既定 3）。体感速度の計測（tests/checks/browser/app-speed.mjs）は、本番の HTTP 経由の保存先と同じく同時に投げられるよう広げて測る（任意）
DATABASE_POOL_MAX=
# ログインの署名の鍵。openssl rand -base64 32 で作る
AUTH_SECRET=
# Google Cloud で作ったログイン用のクライアントの ID
AUTH_GOOGLE_ID=
# Google Cloud で作ったログイン用のクライアントの秘密の値
AUTH_GOOGLE_SECRET=
# 画像の置き場（非公開の Vercel Blob）。Vercel で置き場を繋ぐと自動で入る
BLOB_READ_WRITE_TOKEN=
# 毎日の片付け（古い閲覧記録を消す）の合言葉。無いと片付けが動かない（任意）
CRON_SECRET=
# 手元の AI から資料を直す口。止めるときだけ off にする（任意）
PAGES_AGENT_EDITING=
# 昔の「名前だけで参加した人」の入場券の封を確かめる鍵（任意・読む側だけ・src/lib/access/guest.ts）。省略すると AUTH_SECRET を使う（任意）
GUEST_COOKIE_SECRET=
# 投稿コマンド（bin/pages-publish.mjs）の投稿先の上書き。配る口（src/app/cli/[name]）が設置のサイトの URL を書き込む。サーバーの処理は読まない（任意）
PAGES_HOST=
