{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/scripts/dev/red-test-gate.mjs\"; [ -f \"$f\" ] || exit 0; node \"$f\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
