{
  "name": "surprise-pages-distribution",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/build/widget.mjs && node scripts/build/vendor.mjs && node scripts/build/deck-card.mjs && next dev",
    "build": "node scripts/build/widget.mjs && node scripts/build/vendor.mjs && node scripts/build/deck-card.mjs && next build && node scripts/build/check-public-sourcemaps.mjs",
    "build:widget": "node scripts/build/widget.mjs",
    "build:vendor": "node scripts/build/vendor.mjs",
    "start": "next start",
    "lint": "eslint",
    "check": "node scripts/ci/run-checks.mjs",
    "check:changed": "node scripts/ci/run-checks.mjs --changed",
    "check:inputs": "node scripts/ci/trace-check-inputs.mjs --update",
    "test:deck-loading": "node tests/checks/browser/deck-loading.mjs && node tests/checks/browser/deck-image-loading.mjs && node tests/checks/browser/page-images.mjs",
    "test:presenter": "node tests/support/deck-presenter-browser.mjs",
    "test:runner": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "test:postgres": "node tests/verify-postgres.mjs",
    "verify": "pnpm lint && pnpm check && pnpm build",
    "build:deck-design": "node scripts/build/deck-design.mjs && node scripts/generate/deck-format-catalog.mjs && node scripts/build/deck-library.mjs",
    "build:deck-library": "node scripts/build/deck-library.mjs",
    "build:generated": "pnpm build:deck-design && pnpm build:widget && node scripts/build/document-policy.mjs",
    "test:app-speed": "node tests/checks/browser/app-speed.mjs",
    "dev:local": "node scripts/dev/preview-personal.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/hashes": "1.8.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@sparticuz/chromium": "153.0.0",
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.9.11",
    "diff": "^9.0.0",
    "echarts": "6.1.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "parse5": "8.0.1",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss-v3": "npm:tailwindcss@3.4.17",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "js-yaml": "4.3.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wawoff2": "2.0.1"
  },
  "packageManager": "pnpm@10.33.4"
}
